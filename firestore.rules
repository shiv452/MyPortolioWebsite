rules_version = '2';
// Paste this into: Firebase Console -> Firestore Database -> Rules tab -> Publish.
// No CLI deploy is used since this project has no npm/build tooling.
//
// Every collection (projects, certificates, awards, resumeFiles, profile) follows
// the same policy: public read, write only from a signed-in account. There is no
// public sign-up flow anywhere in the app, so "signed in" already means "the owner".
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
